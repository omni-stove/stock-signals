{
  "name": "stock-signals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "valuation": "node scripts/valuation.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "biome check --write",
    "lint": "biome check --error-on-warnings",
    "knip": "knip",
    "gen:watchlist": "node scripts/gen-watchlist.ts",
    "check:watchlist": "node scripts/gen-watchlist.ts --check",
    "check:mermaid": "node scripts/check-mermaid.ts",
    "test": "vitest run",
    "test:sh": "bash scripts/run-bats.sh",
    "verify:lint": "bash scripts/quiet.sh lint biome check --error-on-warnings",
    "verify:typecheck": "bash scripts/quiet.sh typecheck tsc --noEmit -p tsconfig.json",
    "verify:worker:typecheck": "bash scripts/quiet.sh worker:typecheck pnpm -C worker run typecheck",
    "verify:check:watchlist": "bash scripts/quiet.sh check:watchlist node scripts/gen-watchlist.ts --check",
    "verify:check:mermaid": "bash scripts/quiet.sh check:mermaid node scripts/check-mermaid.ts",
    "verify:test": "bash scripts/quiet.sh test vitest run",
    "verify:worker:test": "bash scripts/quiet.sh worker:test pnpm -C worker run test",
    "verify:test:sh": "bash scripts/quiet.sh test:sh bash scripts/run-bats.sh",
    "verify:knip": "bash scripts/quiet.sh knip knip",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "bats": "^1.13.0",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "mermaid": "^12.1.0",
    "npm-run-all2": "^9.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
