{
  "name": "stock-signals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "valuation": "node scripts/valuation.ts",
    "sector": "node scripts/sector.ts",
    "events": "node scripts/events.ts",
